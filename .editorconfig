# EditorConfig:团队统一基础编辑行为 https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.md]
# Markdown 行尾双空格有语义(硬换行),不做裁剪
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf
